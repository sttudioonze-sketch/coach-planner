# Supabase > Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "service_role" (secreta). Fica só neste servidor; nunca coloque no app.
SUPABASE_SERVICE_ROLE_KEY=

# Pasta onde fica salva a sessão do WhatsApp (não apague, senão pede QR de novo).
WA_AUTH_DIR=./auth

# true = conversas que VOCÊ começa no celular também viram card.
CREATE_LEADS_FROM_OUTGOING=false

LOG_LEVEL=warn
