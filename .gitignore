# This workspace also contains private project material. Track only the site.
*
!/.gitignore
!/.gitattributes
!/README.md
!/site/
/site/*
!/site/index.html
!/site/styles.css
!/site/app.js
!/site/hero-depth.js
!/site/assets/
/site/assets/*
!/site/assets/docs/
/site/assets/docs/*
!/site/assets/docs/*.webp
!/site/assets/banner.webp
!/site/assets/mark.webp
!/site/assets/coachplanner-plano-de-treino.pdf

# Portfólio profissional (deck de páginas)
!/portfolio/
/portfolio/*
!/portfolio/index.html
!/portfolio/styles.css
!/portfolio/app.js
!/portfolio/data.js
!/portfolio/README.md
!/portfolio/assets/
/portfolio/assets/*
!/portfolio/assets/fonts/
/portfolio/assets/fonts/*
!/portfolio/assets/fonts/*.woff2
!/portfolio/assets/fonts/OFL.txt
!/portfolio/assets/fotos/
/portfolio/assets/fotos/*
!/portfolio/assets/fotos/*.jpg
!/portfolio/assets/fotos/*.webp
!/portfolio/assets/fotos/*.png
!/portfolio/assets/escudos/
/portfolio/assets/escudos/*
!/portfolio/assets/escudos/*.png
!/portfolio/assets/escudos/*.svg
!/portfolio/assets/escudos/*.webp
!/portfolio/assets/docs/
/portfolio/assets/docs/*
!/portfolio/assets/docs/*.jpg
!/portfolio/assets/docs/*.webp
!/portfolio/assets/docs/*.png
