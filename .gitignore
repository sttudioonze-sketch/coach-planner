# This workspace also contains private project material. Track only the site.
*
!/.gitignore
!/.gitattributes
!/README.md
!/site/
/site/*
!/site/index.html
!/site/styles.css
!/site/app.js
!/site/hero-depth.js
!/site/assets/
/site/assets/*
!/site/assets/docs/
/site/assets/docs/*
!/site/assets/docs/*.webp
!/site/assets/banner.webp
!/site/assets/mark.webp
!/site/assets/coachplanner-plano-de-treino.pdf

# CRM Kanban integrado ao WhatsApp (não faz parte do site publicado).
!/crm/
/crm/*
!/crm/README.md
!/crm/app/
/crm/app/*
!/crm/app/index.html
!/crm/app/styles.css
!/crm/app/app.js
!/crm/app/config.js
!/crm/supabase/
/crm/supabase/*
!/crm/supabase/migrations/
/crm/supabase/migrations/*
!/crm/supabase/migrations/*.sql
!/crm/bridge/
/crm/bridge/*
